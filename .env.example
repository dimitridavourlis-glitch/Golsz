# Env vars for api/scout.js (Vercel serverless function).
# Copy to .env, fill in, and run `vercel env pull` / `vercel dev` — or set these
# directly in the Vercel dashboard under Settings -> Environment Variables.
# See SETUP.md for the full walkthrough.

# Required
ANTHROPIC_API_KEY=

# Optional — model override (defaults to claude-sonnet-5 if unset)
SCOUT_MODEL=
SCOUT_HAIKU_MODEL=

# Optional — a second/third provider for the economy tier (Multi-Model Cost-
# Control System). Neither does anything until its scout_model_config row is
# also flipped to enabled=true — see CLAUDE.md's "Multi-Model AI Scout &
# Cost-Control System" section. Get these from:
#   xAI (Grok):    https://console.x.ai  -> API Keys
#   Google (Gemini): https://aistudio.google.com/apikey
XAI_API_KEY=
GOOGLE_AI_API_KEY=

# Optional — restrict CORS to your deployed origin (defaults to * if unset)
ALLOWED_ORIGIN=

# Optional — set both to enable auth verification + real per-plan metering.
# Leaving these unset makes /api/scout accept unauthenticated requests with no rate limit.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional — Scout questions/day per plan (defaults: 3 / 8 / 15 / 20)
FREE_DAILY_LIMIT=
STARTER_DAILY_LIMIT=
PRO_DAILY_LIMIT=
ELITE_DAILY_LIMIT=

# Optional — emergency kill switches (default: both enabled, no spend cap)
SCOUT_GLOBAL_ENABLED=
SCOUT_PREMIUM_ENABLED=
SCOUT_DAILY_SPEND_LIMIT_USD=
SCOUT_MONTHLY_SPEND_LIMIT_USD=
