// Every column name api/scout.js selects must exist, and every key it reads
// off the result must be one it selected.
//
// THE CLASS THIS CLOSES — third instance in one day
// A wrong column name is invisible at runtime in two different ways, and
// neither produces an error, a log line, or a failing test:
//
//   1. WRONG NAME IN THE SELECT. PostgREST rejects the ENTIRE request on an
//      unknown column, so the whole fetch returns an error body, the caller's
//      `catch` swallows it, and every field that query was supposed to provide
//      silently becomes absent. 2026-08-13: `career_timeline` was added to
//      buildAuthoritativeContext's select. That column does not exist — the
//      real one is `timeline` (migration 065) — which would have emptied the
//      whole authoritative-context block, not just the timeline part.
//
//   2. WRONG KEY ON THE RESULT. `athleteRow.career_timeline` is `undefined`
//      forever. Array.isArray(undefined) is false, the array stays empty, the
//      prompt line never renders, and Scout simply never mentions the athlete's
//      timeline. A feature that never appears looks identical to a feature
//      nobody uses.
//
// The other two instances today were the same shape: the highlight -> posts
// insert that had produced ZERO rows since it shipped, and `answered_by`
// meaning both faq and cache. See golsz-guard/measurement-integrity.
//
// Truth comes from the schema's own `alter table athletes add column`
// statements plus the create table, not from a list retyped here.

const fs = require("fs");
const path = require("path");
const REPO = path.join(__dirname, "..");
const SCOUT = fs.readFileSync(path.join(REPO, "api/scout.js"), "utf8");
const SCHEMA = fs.readFileSync(path.join(REPO, "supabase-schema.sql"), "utf8");

let p = 0, f = 0;
const ck = (l, a, e) => {
  const A = JSON.stringify(a), E = JSON.stringify(e);
  if (A === E) { p++; console.log("PASS  " + l); }
  else { f++; console.log(`FAIL  ${l}\n   exp ${E}\n   got ${A}`); }
};

// ---- the real columns on athletes ---------------------------------------
const cols = new Set();
for (const m of SCHEMA.matchAll(/alter table athletes\s+add column(?: if not exists)?\s+(\w+)/gi)) cols.add(m[1]);
const ct = SCHEMA.slice(SCHEMA.indexOf("create table if not exists athletes"));
const ctBody = ct.slice(0, ct.indexOf("\n);"));
for (const m of ctBody.matchAll(/^\s+(\w+)\s+\w/gm)) { const k = m[1].toLowerCase(); if (!["primary","foreign","unique","check","constraint","references"].includes(k)) cols.add(m[1]); }
ck("the schema yielded a plausible column set", cols.size > 20, true);
ck("...including the ones this bug was about", ["timeline", "highlights", "scout_context"].filter((c) => !cols.has(c)), []);
ck("...and NOT the name that does not exist", cols.has("career_timeline"), false);

// ---- every athletes select in scout.js ----------------------------------
// Matches `/rest/v1/athletes?...&select=a,b,c` however the URL is concatenated.
const selects = [...SCOUT.matchAll(/athletes\?[\s\S]{0,200}?select=([a-z_,]+)/g)].map((m) => m[1]);
ck("found the athletes selects in scout.js", selects.length >= 1, true);
const selected = new Set();
const bogus = [];
for (const sel of selects) {
  for (const c of sel.split(",").map((x) => x.trim()).filter(Boolean)) {
    selected.add(c);
    if (!cols.has(c)) bogus.push(c);
  }
}
// The one that matters: an unknown column kills the WHOLE request.
ck("every selected column exists on athletes", [...new Set(bogus)], []);

// ---- and the `cols` string used by buildAuthoritativeContext ------------
const colsDecl = /const cols = "([a-z_,]+)"/.exec(SCOUT);
ck("the cols declaration was found", !!colsDecl, true);
const declBogus = colsDecl[1].split(",").map((x) => x.trim()).filter((c) => c && !cols.has(c));
ck("every column in the cols string exists", declBogus, []);
colsDecl[1].split(",").forEach((c) => selected.add(c.trim()));

// ---- keys read off athleteRow must have been selected ------------------
// This is the half that stays silent: a typo here is `undefined`, not an error.
const reads = [...new Set([...SCOUT.matchAll(/athleteRow\.([a-z_]+)/g)].map((m) => m[1]))];
ck("found athleteRow reads", reads.length > 0, true);
ck("every key read off athleteRow was actually selected",
   reads.filter((r) => !selected.has(r)), []);

console.log(`\n${p}/${p + f} passed`);
process.exit(f ? 1 : 0);
